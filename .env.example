# Server Port
PORT=8080

# Database Configuration
# Path to SQLite database file
DATABASE_PATH=./data/netminder.sqlite3

# Security - JWT Secret
# IMPORTANT: Generate a secure random secret for production
# Use: openssl rand -base64 32
# Or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your-secure-random-secret-here-change-this-in-production

# Configuration Encryption Key
# Used to encrypt QRZ credentials stored in the database.
# NetMinder uses a built-in development key when this is unset locally, but you MUST set a unique value in production.
# Keep this key stable and backed up to preserve access to stored credentials.
# Generate with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=your-config-encryption-key-change-me

# Address Geocoding (optional)
# Used only when an administrator enables "Geocode station addresses" in Settings.
# GEOCODER_URL defaults to the public OpenStreetMap Nominatim service; set it to use a self-hosted Nominatim.
# GEOCODER_EMAIL is sent with requests so the service operator can contact you; recommended for the public service.
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_EMAIL=you@example.com
